<header>
  <h1>Loja Virtual</h1>

  <% if (user) { %>

    <% 
      let foto = user && user.image ? user.image : "../../assets/user.png";
    %>

    <div style="
        display:flex;
        align-items:center;
        justify-content:flex-end;
        gap:10px;
        text-align:right;
    ">
      
      <a href="/meuPerfil">
        <h5 style="color:white; margin:0;">
          Meu Perfil
        </h5>

        <img 
          src="<%= foto %>" 
          style="width:60px; height:60px; border-radius:50%; object-fit:cover;"
        >
      </a>

    </div>

  <% } %>

  <nav>
    
    <a href="/">Início</a>
    <a href="/meusProdutos">Meus Produtos</a>
    

    <% if (user && user.type === 'admin') { %>
      <a href="/usuarios">Usuários</a>
    <% } %>

    <a href="/contato">Contato</a>
    <a href="/sobre">Sobre</a>
    <a href="/carrinho">Carrinho</a>

    <% if (user) { %>
    <a id="logoutBtn">Sair (<%= user.name %>)</a>
    <% } else { %>
      <a href="/login">Login</a>
     
    <% } %>

  </nav>

<section>
  <h6>Buscar Produto</h6>
  <input type="text" id="search-name" placeholder="Procurar..." />
  
  <button style="background-color:purple;"  onclick="buscarPorNome()">🔎</button>
</section>



  <script type="module" src="/js/logout.js"></script>


</header>




<script>function buscarPorNome() {
  const nome = document.getElementById('search-name').value.trim();
  if (!nome) {
    alert('Digite um nome para buscar');
    return;
  }

  window.location.href = `/buscar?nome=${encodeURIComponent(nome)}`;
}</script>