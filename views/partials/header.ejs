                  <a href="/cadastroUsuario">Cadastro</a>
                  <% } %>

        </nav>


<script src="/js/logout.js"></script>


</header>

  <% if (user) { %>
   <h5> Bem-vindo, <%= user.name %>!</h5>
      <% } %>
