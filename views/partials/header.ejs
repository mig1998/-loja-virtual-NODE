<header>
  <h1>Loja Virtual</h1>




        <nav>
          <a href="/">Início</a>
          <a href="/cadastroProduto">Novo Produto</a>

          <a href="/meusProdutos">Meus Produtos</a>

          <a href="/produtos">Produtos</a>

          <% if (user && user.type==='admin' ) { %>
            <a href="/usuarios">Usuários</a>
            <% } %>

              <a href="/contato">Contato</a>
