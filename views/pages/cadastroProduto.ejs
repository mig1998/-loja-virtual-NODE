<%- include('../layout', { title: title, body: ` <h2>Página Inicial</h2>
 
 

  <h2>Criar Novo Produto</h2>
  <form id="create-produto-form">
    <input type="text" placeholder="nome do produto" id="name" required>
    <input type="text" placeholder="descrição" id="description">
    <input type="number" placeholder="R$" id="price" required>
    <select name="categoria" id="categoria">
      <option value="eletronicos">Eletrônicos</option>
      <option value="livros">Livros</option>
    </select>
    <button type="submit">Criar Produto</button>
  </form>
  
<script src="/js/cadastroProduto.js"></script>

  `
  }) %>